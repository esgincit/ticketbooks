# ─────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────
# Two URLs are used:
#   DATABASE_URL  -> what the app connects to at runtime (use a POOLED connection in production)
#   DIRECT_URL    -> what `prisma migrate` uses (must bypass transaction-poolers)
#
# Local Docker Postgres (`npm run db:up`):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ticketing?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ticketing?schema=public"

# Supabase (Project Settings -> Connect):
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Plain PostgreSQL (RDS/Neon/Railway/...):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
# DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ─────────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
SESSION_SECRET="generate-a-long-random-string"   # used to sign session cookies
SESSION_DAYS="7"

# ─────────────────────────────────────────────────────────────
# EMAIL  (console | smtp)
# ─────────────────────────────────────────────────────────────
EMAIL_PROVIDER="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="TicketBooks <no-reply@yourdomain.com>"

# Inbound email-to-ticket webhook shared secret (POST /api/email/inbound)
INBOUND_EMAIL_SECRET=""

# ─────────────────────────────────────────────────────────────
# UPLOADS / LIMITS
# ─────────────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="20"

# SLA at-risk window in hours (admin can override in Settings > SLA)
SLA_RISK_HOURS="24"

# ─────────────────────────────────────────────────────────────
# FILE STORAGE
# ─────────────────────────────────────────────────────────────
# Leave empty to store uploads on local disk (self-hosting).
# On Vercel/serverless, set these to store attachments in Supabase Storage:
#   SUPABASE_URL              e.g. https://psyreixjpbitdjjbdphv.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY Project Settings -> API -> service_role key (keep secret!)
#   SUPABASE_STORAGE_BUCKET   default "attachments" (create as a PRIVATE bucket)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="attachments"

# ─────────────────────────────────────────────────────────────
# SCHEDULED JOBS (SLA breach scan + email retries)
# ─────────────────────────────────────────────────────────────
# Required on Vercel; vercel.json schedules GET /api/cron and Vercel sends
# this secret automatically as a Bearer token.
CRON_SECRET=""

# ─────────────────────────────────────────────────────────────
# AI TOOLS (MCP at /api/mcp)
# ─────────────────────────────────────────────────────────────
# Optional: only these email domains may connect AI tools (empty = any active user)
ALLOWED_EMAIL_DOMAINS=""
# Optional: https callback hosts allowed for web-based AI clients (CLI tools use localhost and need nothing)
MCP_ALLOWED_REDIRECT_HOSTS=""
